# TODO: pin to the first scanner release which ships crane, devguard-scanner and jq in /usr/local/bin (version@sha256:digest)
FROM ghcr.io/l3montree-dev/devguard/scanner:main AS devguard-scanner
# https://github.com/l3montree-dev/devguard

# checkov:skip=CKV_DOCKER_2
# checkov:skip=CKV_DOCKER_3

FROM registry.opencode.de/oci-community/images/l3montree/kaniko:v1.28.3-debug@sha256:458a8c3ad450bf384906c507b09624bd1c8baa9683f12a222281381e0aaf51ed
# https://github.com/osscontainertools/kaniko
# https://gitlab.opencode.de/oci-community/images/l3montree/kaniko

# static binaries at stable paths in the scanner image - jq is needed to set the subject of the build provenance
COPY --from=devguard-scanner /usr/local/bin/crane /crane
COPY --from=devguard-scanner /usr/local/bin/devguard-scanner /devguard-scanner
COPY --from=devguard-scanner /usr/local/bin/jq /jq

WORKDIR /workspace

ENTRYPOINT ["/kaniko/executor"]
